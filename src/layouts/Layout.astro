---
import "../styles/global.css";
const year = new Date().getFullYear();
interface Props {
title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
		<link rel="icon" type="image/png" href="/EMMIcon/favicon_2.png" sizes="any" />

	</head>

	<body>
		<nav>
			<img
				src="/EMMIcon/Transparent/logo_glow_notext.png"
				alt="Easy Money Manager"
				class="logo"
			/>
			<!---strong>EMM</strong--->

			<a href= "https://app.easy-money-manager.com">Web app</a>
			<a href="https://github.com/easy-money-manager">GitHub</a>
			<a href="about">About</a>
		</nav>

		<main>
			<slot />
		</main>
		<footer>
			© {year} Easy Money Manager contributor(s).<br>
			Licensed under APGL-3.0
		</footer>
	</body>
</html>
