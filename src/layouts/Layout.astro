---
import "../styles/global.css";
const year = new Date().getFullYear();
interface Props {
title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
		<title>{title}</title>

    </head>

    <body>
        <nav>
            <strong>EMM</strong>

            <a href="https://github.com/easy-money-manager">GitHub</a>
			<a href="about">About</a>
        </nav>

        <main>
			<slot />
        </main>
		<footer>
			© {year} Easy Money Manager contributor(s).<br>
			Licenced under APGL-3.0
		</footer>
    </body>
</html>
