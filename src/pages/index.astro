---
const projects = [
    {
        name: "Easy Money Manager",
        description: "Personal finance management and economic analysis.",
        href: "https://github.com/easy-money-manager/easy-money-manager",
    },
    {
        name: "EMM Calculator",
        description: "Financial and economic calculation tools.",
        href: "https://github.com/easy-money-manager/emm-calculator",
    },
    {
        name: "EMM site",
        description: "Site you're seeing :-)",
        href: "https://github.com/easy-money-manager/easy-money-manager.github.io",
    },
];
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <title>Easy Money Manager</title>

        <style>
            :root {
                font-family: system-ui, sans-serif;
                background: #111;
                color: #eee;
            }

            body {
                margin: 0;
            }

            nav {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 1.2rem 2rem;
                border-bottom: 1px solid #333;
            }

            nav a {
                color: #eee;
                text-decoration: none;
            }

            main {
                max-width: 1000px;
                margin: 0 auto;
                padding: 4rem 2rem;
            }

            .hero {
                padding: 5rem 0;
            }

            .hero h1 {
                margin: 0;
                font-size: clamp(3rem, 8vw, 6rem);
            }

            .hero p {
                max-width: 650px;
                color: #aaa;
                font-size: 1.2rem;
                line-height: 1.6;
            }

            .projects {
                display: grid;
                gap: 1rem;
                grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            }

            .project {
                display: block;
                padding: 1.5rem;
                border: 1px solid #333;
                border-radius: 12px;
                color: inherit;
                text-decoration: none;
            }

            .project:hover {
                border-color: #777;
            }

            .project h3 {
                margin-top: 0;
            }

            .project p {
                color: #aaa;
            }
        </style>
    </head>

    <body>
        <nav>
            <strong>EMM</strong>

            <a href="https://github.com/easy-money-manager">GitHub</a>
        </nav>

        <main>
            <section class="hero">
                <h1>Easy Money Manager</h1>

                <p>Open-source software for personal finance, later also economic analysis, and financial tools.</p>
            </section>

            <section>
                <h2>Projects</h2>

                <div class="projects">
                    {
                        projects.map((project) => (
                            <a class="project" href={project.href}>
                                <h3>{project.name}</h3>
                                <p>{project.description}</p>
                            </a>
                        ))
                    }
                </div>
            </section>
        </main>
    </body>
</html>
