---
import ProjectCard from "../components/ProjectCard.astro";
import "../styles/global.css";

const year = new Date().getFullYear();
const projects = [
    {
        name: "Easy Money Manager",
        description: "Personal finance management and economic analysis.",
        href: "https://github.com/easy-money-manager/easy-money-manager",
		status: "In development",
    },
    {
        name: "EMM Calculator",
        description: "Financial and economic calculation tools.",
        href: "https://github.com/easy-money-manager/emm-calculator",
		status: "Early development",
    },
    {
        name: "EMM site",
        description: "Site you're seeing :-)",
        href: "https://github.com/easy-money-manager/easy-money-manager.github.io",
		status: "Early development",
    },
];
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <title>Easy Money Manager</title>

    </head>

    <body>
        <nav>
            <strong>EMM</strong>

            <a href="https://github.com/easy-money-manager">GitHub</a>
        </nav>

        <main>
            <section class="hero">
                <h1>Easy Money Manager</h1>

                <p>Open-source software for personal finance, later also economic analysis, and financial tools.</p>
            </section>

			<section>
				<h2>Projects</h2>

				<div class="projects">
					{
					projects.map((project) => (
					<ProjectCard
					name={project.name}
					description={project.description}
					href={project.href}
					status={project.status}
					/>
					))
					}
				</div>
			</section>
        </main>
		<footer>
			    © {year} Easy Money Manager
		</footer>
    </body>
</html>
