---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
const projects = [
    {
        name: "Easy Money Manager",
        description: "Personal finance management and economic analysis.",
        href: "https://github.com/easy-money-manager/easy-money-manager",
		status: "Very early version",
    },
    {
        name: "EMM Calculator",
        description: "Financial and economic calculation tools.",
        href: "https://github.com/easy-money-manager/emm-calculator",
		status: "Early development",
    },
    {
        name: "EMM site",
        description: "Site you're seeing :-)",
        href: "https://github.com/easy-money-manager/easy-money-manager.github.io",
		status: "Very early version",
    },
];
---
<Layout title="Easy Money Manager">
<section class="hero">
	<h1>Easy Money Manager</h1>

	<p>Open-source software for personal finance and financial tools.</p>
</section>

<section>
	<h2>Projects</h2>

	<div class="projects">
		{
		projects.map((project) => (
		<ProjectCard
		name={project.name}
		description={project.description}
		href={project.href}
		status={project.status}
		/>
		))
		}
	</div>
</section>
</Layout>
