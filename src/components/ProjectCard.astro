---
interface Props {
name: string;
description: string;
href: string;
status?: string;
}

const { name, description, href, status } = Astro.props;
---

<a class="project" href={href}>
	<h3>{name}</h3>
	{status && <span class="status">{status}</span>}
	<p>{description}</p>
</a>

<style>
.ProjectCard:hover {
	border-color: #777;
}

.ProjectCard h3 {
	margin-top: 0;
}

.ProjectCard p {
	color: #aaa;
}

.status {
	display: inline-block;
	padding: 0.25rem 0.6rem;
	border: 1px solid #444;
	border-radius: 999px;
	font-size: 0.8rem;
	color: #aaa;
}
</style>
